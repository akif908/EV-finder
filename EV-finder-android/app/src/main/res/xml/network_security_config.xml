<?xml version="1.0" encoding="utf-8"?>
<!-- Permit cleartext + clear localhost for the dev backend;
     overpass-api.de + the kumi mirror remain HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
