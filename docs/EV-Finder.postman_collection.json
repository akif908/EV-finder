    {
      "name": "2. Setup (run once, saves ids)",
      "item": [
        {
          "name": "Save station + service ids",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const list = pm.response.json();",
              "pm.test('stations returned', () => pm.expect(list.length).to.be.above(0));",
              "pm.collectionVariables.set('stationId', list[0].id);",
              "pm.collectionVariables.set('serviceId', list[0].services[0].id);",
              "const d = new Date(Date.now() + 2*864e5).toISOString().slice(0,10);",
              "pm.collectionVariables.set('slotDate', d);"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/stations", "host": ["{{baseUrl}}"], "path": ["api", "stations"] }
          }
        },
        {
          "name": "Save vehicle id",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const list = pm.response.json();",
              "pm.test('at least one vehicle exists', () => pm.expect(list.length).to.be.above(0));",
              "pm.collectionVariables.set('vehicleId', list[0].id);"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/vehicles/my", "host": ["{{baseUrl}}"], "path": ["api", "vehicles", "my"] }
          }
        },
        {
          "name": "Save fuel station id",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const list = pm.response.json();",
              "if (list.length) pm.collectionVariables.set('fuelStationId', list[0].id);"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/fuel-stations", "host": ["{{baseUrl}}"], "path": ["api", "fuel-stations"] }
          }
        }
      ]
    },
