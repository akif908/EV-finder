{
  "info": {
    "name": "EV Finder — CSE 2118 Project Tests",
    "_postman_id": "b7f1c2a4-9d3e-4a51-8f60-2c7e5b91a001",
    "description": "Acceptance tests for the EV Charging & Battery-Swap Finder backend.\n\nHOW TO USE FOR SCREENSHOTS\n1. Import this file into Postman (File > Import).\n2. Set the collection variable `baseUrl` (default http://localhost:8080).\n3. Run the three requests in the `1. Auth` folder first — their test scripts save the JWTs\n   into collection variables, so every later request authenticates automatically.\n4. Run `2. Setup` once — it saves stationId / serviceId / vehicleId / bookingId that the\n   later requests reuse.\n5. Open each request, press Send, and screenshot the request (method + URL + body) together\n   with the response (status code + body). That single screenshot is what Section 8 needs.\n\nEach request carries a `pm.test` assertion, so the Postman test result tab also shows PASS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userToken", "value": "" },
    { "key": "operatorToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "stationId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "vehicleId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "fuelStationId", "value": "" },
    { "key": "slotDate", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "TC-01 Login as USER (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('TC-01 status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('role is USER and token returned', () => { pm.expect(b.role).to.eql('USER'); pm.expect(b.token).to.be.a('string'); });",
                  "pm.collectionVariables.set('userToken', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@ev.com\",\n  \"password\": \"secret123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login as OPERATOR (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('operatorToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"operator@ev.com\",\n  \"password\": \"operator123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login as ADMIN (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@ev.com\",\n  \"password\": \"admin123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
